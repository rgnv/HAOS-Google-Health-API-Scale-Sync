HA_URL=https://homeassistant.example.invalid:8123
HA_TOKEN=replace-with-a-home-assistant-long-lived-token
HA_MEASUREMENT_ID_ENTITY=sensor.ge_fit_plus_ln_measurement_id
HA_WEIGHT_ENTITY=sensor.ge_fit_plus_ln_weight
HA_BODY_FAT_ENTITY=sensor.ge_fit_plus_ln_body_fat
SYNC_SOURCE=home-assistant
POLL_SECONDS=60
GOOGLE_CLIENT_SECRETS=/data/client_secret.json
GOOGLE_TOKEN_FILE=/data/google-token.json
SYNC_DB=/data/sync.sqlite3
OAUTH_BIND_HOST=0.0.0.0
OAUTH_PORT=8765
